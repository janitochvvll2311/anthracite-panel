{
  "name": "@anth-panel/client",
  "version": "0.8.2",
  "type": "module",
  "description": "Generated clients for Anthracite apps",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/janitochvvll2311/anthracite-panel"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --format esm --target browser && tsc -p tsconfig.build.json && bun ../../../scripts/fix-dts.ts dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
