package anth:env@1.0.0;

/// Host facts that never leak a path or a process (§9.2).
interface info {
    record facts {
        hostname: string,
        os: string,
        arch: string,
        uptime-seconds: u64,
        cpu-count: u32,
        memory-bytes: u64,
    }

    get: func() -> facts;
}

interface time {
    /// Wall clock, milliseconds since the Unix epoch.
    now-ms: func() -> u64;
    /// Monotonic milliseconds since the process started.
    monotonic-ms: func() -> u64;
}

interface log {
    enum level {
        error,
        warn,
        info,
        debug,
    }

    write: func(level: level, message: string);
}

interface random {
    use anth:error/kinds@1.0.0.{error};

    /// Cryptographically secure bytes, up to the per-call cap. A larger request
    /// is `too-large`, not a silently truncated value.
    bytes: func(count: u32) -> result<list<u8>, error>;
}
