manifest_version = 3

[app]
id = "org.anthracite.net"
namespace = "anthracite:net"
name = "Network (emulator)"
version = "0.1.0"
summary = "Deterministic interface and route fixture for the demo; replaced by the real net app."
license = "Apache-2.0"

[service]
path = "bin/host-emulator"
sha256 = "{{sha256}}"
class = "socket"
argv = ["--socket", "{socket}"]

[[export]]
interface = "anthracite:net/net@1.0.0"

[[route]]
method = "GET"
path = "/interfaces"
call = "anthracite:net/net@1.0.0#interfaces"

[[route]]
method = "GET"
path = "/routes"
call = "anthracite:net/net@1.0.0#routes"

[[slot]]
id = "panel.view"
label = "Network"
icon = "network"
order = 21
tag = "anth-net"
module = "web/net.js"
sha256 = "{{module_sha256}}"

[[cli]]
call = "anthracite:net/net@1.0.0#interfaces"
verb = "interfaces"

[[cli]]
call = "anthracite:net/net@1.0.0#routes"
verb = "routes"
