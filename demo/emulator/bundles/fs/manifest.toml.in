manifest_version = 3

[app]
id = "org.anthracite.fs"
namespace = "anthracite:fs"
name = "Files (emulator)"
version = "0.5.0"
summary = "Deterministic filesystem fixture for the demo; replaced by the real fs app."
license = "Apache-2.0"

[service]
path = "bin/host-emulator"
sha256 = "{{sha256}}"
class = "socket"
argv = ["--socket", "{socket}", "--state", "{data}/state.json"]

[[export]]
interface = "anthracite:fs/read@1.2.0"

[[export]]
interface = "anthracite:fs/write@1.2.0"

[[route]]
method = "GET"
path = "/files"
call = "anthracite:fs/read@1.2.0#list"

[[route]]
method = "GET"
path = "/stat"
call = "anthracite:fs/read@1.2.0#stat"

[[route]]
method = "GET"
path = "/file"
call = "anthracite:fs/read@1.2.0#read-file"

[[route]]
method = "GET"
path = "/target"
call = "anthracite:fs/read@1.2.0#read-link"

[[route]]
method = "PUT"
path = "/file"
call = "anthracite:fs/write@1.2.0#write-file"

[[route]]
method = "POST"
path = "/dir"
call = "anthracite:fs/write@1.2.0#mkdir"

[[route]]
method = "POST"
path = "/symlink"
call = "anthracite:fs/write@1.2.0#symlink"

[[route]]
method = "DELETE"
path = "/entry"
call = "anthracite:fs/write@1.2.0#remove"

[[route]]
method = "GET"
path = "/trash"
call = "anthracite:fs/read@1.2.0#trash"

[[route]]
method = "POST"
path = "/rename"
call = "anthracite:fs/write@1.2.0#rename"

[[route]]
method = "POST"
path = "/restore"
call = "anthracite:fs/write@1.2.0#restore"

[[cli]]
call = "anthracite:fs/read@1.2.0#list"
verb = "files"

[[cli]]
call = "anthracite:fs/read@1.2.0#stat"
verb = "file-stat"

[[cli]]
call = "anthracite:fs/read@1.2.0#read-file"
verb = "file-read"

[[cli]]
call = "anthracite:fs/read@1.2.0#trash"
verb = "trash"

[[cli]]
call = "anthracite:fs/write@1.2.0#rename"
verb = "rename"

[[cli]]
call = "anthracite:fs/write@1.2.0#restore"
verb = "restore"

[[slot]]
id = "panel.view"
label = "Files"
icon = "folder"
order = 10
tag = "anth-fs"
module = "web/fs.js"
sha256 = "{{module_sha256}}"

[[slot]]
id = "panel.view"
label = "Editor"
icon = "pen"
order = 11
hidden = true
tag = "anth-fs-editor"
module = "web/fs.js"
sha256 = "{{module_sha256}}"
