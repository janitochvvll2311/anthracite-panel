# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local debug config, secrets and state (debug builds use ./ defaults).
/config.toml
/secrets.toml
/state/
# Reference extension sources live under extensions/; only built bundles and the
# registry installed by a debug run are generated.
/extensions/bundles/
/extensions/*/dist/
/extensions/*/backend/target/
/extensions.d/
/anth.sock
/backend/config.toml
/backend/secrets.toml
/backend/state/
/backend/extensions/
/backend/extensions.d/
/backend/anth.sock
/dist/
/frontend/node_modules/
/frontend/dist/
/backend/anth-panel/www/*
!/backend/anth-panel/www/.gitkeep

*.toml.lock
/tests/node_modules/
/tests/test-results/
/tests/playwright-report/
