[Unit]
Description=Anthracite Panel
Documentation=https://github.com/janitochvvll2311/anthracite-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The panel manages host state (network, firewall, storage, accounts), so this
# unit runs as root. The container/tarball documentation says which capabilities
# a less-privileged deployment would need.
User=root
Group=root
ExecStart=/usr/local/bin/anth-panel run --config /etc/anth/config.toml --addr 0.0.0.0:8080
Restart=on-failure
RestartSec=2
StateDirectory=anth
ConfigurationDirectory=anth
# A hung daemon should not hold the socket forever.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
