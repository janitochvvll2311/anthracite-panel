manifest_version = 3

[app]
id = "org.anthracite.proc"
namespace = "anthracite:proc"
name = "Processes"
version = "0.6.0"
summary = "Process table, allowlisted signals and detached spawn."
license = "Apache-2.0"
icon = "activity"

[service]
path = "{{service_path}}"
sha256 = "{{sha256}}"
class = "{{service_class}}"
argv = {{service_argv}}

[[export]]
interface = "anthracite:proc/proc@1.1.0"

[[route]]
method = "GET"
path = "/processes"
call = "anthracite:proc/proc@1.1.0#list"

[[route]]
method = "POST"
path = "/signal"
call = "anthracite:proc/proc@1.1.0#signal"

[[route]]
method = "POST"
path = "/spawn"
call = "anthracite:proc/proc@1.1.0#spawn"

[[slot]]
id = "panel.view"
label = "Processes"
icon = "activity"
order = 20
tag = "anth-proc"
module = "web/proc.js"
sha256 = "{{module_sha256}}"

[[slot]]
id = "panel.fab"
label = "Spawn"
icon = "plus"
order = 30
tag = "proc-spawn"
view = "anth-proc"
module = ""
sha256 = ""

[[slot.actions]]
label = "Spawn"
icon = "plus"
tag = "spawn"
target = "proc-spawn-modal"

[[slot]]
id = "panel.modal"
label = "Spawn process"
order = 31
tag = "proc-spawn-modal"
module = "web/proc-modal.js"
sha256 = "{{modal_sha256}}"

[[cli]]
call = "anthracite:proc/proc@1.1.0#list"
verb = "processes"

[[cli]]
call = "anthracite:proc/proc@1.1.0#signal"
verb = "process-signal"

[[cli]]
call = "anthracite:proc/proc@1.1.0#spawn"
verb = "process-spawn"
