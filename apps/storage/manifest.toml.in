manifest_version = 3

[app]
id = "org.anthracite.storage"
namespace = "anthracite:storage"
name = "{{app_name}}"
version = "0.6.0"
summary = "{{app_summary}}"
license = "Apache-2.0"
icon = "disk"

[service]
path = "{{service_path}}"
sha256 = "{{sha256}}"
class = "{{service_class}}"
argv = {{service_argv}}

[[export]]
interface = "anthracite:storage/storage@1.2.0"

[[route]]
method = "GET"
path = "/devices"
call = "anthracite:storage/storage@1.2.0#devices"

[[route]]
method = "GET"
path = "/mounts"
call = "anthracite:storage/storage@1.2.0#mounts"

[[route]]
method = "POST"
path = "/mount"
call = "anthracite:storage/storage@1.2.0#attach"

[[route]]
method = "POST"
path = "/unmount"
call = "anthracite:storage/storage@1.2.0#detach"

[[slot]]
id = "panel.view"
label = "Storage"
icon = "disk"
order = 22
tag = "anth-storage"
module = "web/storage.js"
sha256 = "{{module_sha256}}"

[[slot]]
id = "panel.fab"
label = "Mount"
icon = "plus"
order = 30
tag = "storage-mount"
view = "anth-storage"
module = ""
sha256 = ""

[[slot.actions]]
label = "Mount"
icon = "plus"
tag = "mount"
target = "storage-mount-modal"

[[slot]]
id = "panel.modal"
label = "Mount device"
order = 31
tag = "storage-mount-modal"
module = "web/storage-modal.js"
sha256 = "{{modal_sha256}}"

[[cli]]
call = "anthracite:storage/storage@1.2.0#devices"
verb = "devices"

[[cli]]
call = "anthracite:storage/storage@1.2.0#mounts"
verb = "mounts"

[[cli]]
call = "anthracite:storage/storage@1.2.0#attach"
verb = "mount"

[[cli]]
call = "anthracite:storage/storage@1.2.0#detach"
verb = "unmount"
