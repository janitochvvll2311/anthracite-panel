manifest_version = 3

[app]
id = "org.anthracite.accounts"
namespace = "anthracite:accounts"
name = "Accounts (emulator)"
version = "0.2.0"
summary = "Deterministic users and groups fixture for the demo; replaced by the real accounts app."
license = "Apache-2.0"

[service]
path = "bin/host-emulator"
sha256 = "{{sha256}}"
class = "socket"
argv = ["--socket", "{socket}", "--state", "{data}/../../emulator/host.json"]

[[export]]
interface = "anthracite:accounts/accounts@1.1.0"

[[route]]
method = "GET"
path = "/users"
call = "anthracite:accounts/accounts@1.1.0#users"

[[route]]
method = "GET"
path = "/groups"
call = "anthracite:accounts/accounts@1.1.0#groups"

[[route]]
method = "POST"
path = "/user"
call = "anthracite:accounts/accounts@1.1.0#create-user"

[[route]]
method = "DELETE"
path = "/user"
call = "anthracite:accounts/accounts@1.1.0#delete-user"

[[route]]
method = "POST"
path = "/lock"
call = "anthracite:accounts/accounts@1.1.0#set-lock"

[[slot]]
id = "panel.view"
label = "Accounts"
icon = "users"
order = 23
tag = "anth-accounts"
module = "web/accounts.js"
sha256 = "{{module_sha256}}"

[[cli]]
call = "anthracite:accounts/accounts@1.1.0#users"
verb = "users"

[[cli]]
call = "anthracite:accounts/accounts@1.1.0#groups"
verb = "groups"

[[cli]]
call = "anthracite:accounts/accounts@1.1.0#create-user"
verb = "user-create"

[[cli]]
call = "anthracite:accounts/accounts@1.1.0#delete-user"
verb = "user-delete"

[[cli]]
call = "anthracite:accounts/accounts@1.1.0#set-lock"
verb = "user-lock"
