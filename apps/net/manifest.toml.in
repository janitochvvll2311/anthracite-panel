manifest_version = 3

[app]
id = "org.anthracite.net"
namespace = "anthracite:net"
name = "{{app_name}}"
version = "0.6.0"
summary = "{{app_summary}}"
license = "Apache-2.0"

[service]
path = "{{service_path}}"
sha256 = "{{sha256}}"
class = "{{service_class}}"
argv = {{service_argv}}

[[export]]
interface = "anthracite:net/net@1.2.0"

[[route]]
method = "GET"
path = "/interfaces"
call = "anthracite:net/net@1.2.0#interfaces"

[[route]]
method = "GET"
path = "/routes"
call = "anthracite:net/net@1.2.0#routes"

[[route]]
method = "GET"
path = "/watch"
call = "anthracite:net/net@1.2.0#watch"
stream = true
events = true

[[route]]
method = "POST"
path = "/up"
call = "anthracite:net/net@1.2.0#set-up"

[[route]]
method = "POST"
path = "/route"
call = "anthracite:net/net@1.2.0#add-route"

[[route]]
method = "DELETE"
path = "/route"
call = "anthracite:net/net@1.2.0#remove-route"

[[slot]]
id = "panel.view"
label = "Network"
icon = "network"
order = 21
tab = "Interfaces"
tag = "anth-net"
module = "web/net.js"
sha256 = "{{module_sha256}}"

[[slot]]
id = "panel.fab"
label = "Add route"
icon = "network"
order = 30
tag = "net-route"
view = "anth-net"
module = ""
sha256 = ""

[[slot.actions]]
label = "Add route"
tag = "add-route"
target = "net-route-modal"

[[slot]]
id = "panel.modal"
label = "Add route"
order = 31
tag = "net-route-modal"
module = "web/net-modal.js"
sha256 = "{{modal_sha256}}"

[[cli]]
call = "anthracite:net/net@1.2.0#interfaces"
verb = "interfaces"

[[cli]]
call = "anthracite:net/net@1.2.0#routes"
verb = "routes"

[[cli]]
call = "anthracite:net/net@1.2.0#set-up"
verb = "interface-up"

[[cli]]
call = "anthracite:net/net@1.2.0#add-route"
verb = "route-add"

[[cli]]
call = "anthracite:net/net@1.2.0#remove-route"
verb = "route-remove"
