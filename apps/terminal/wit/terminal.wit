package anthracite:terminal@1.0.0;

interface terminal {
    use anth:error/kinds@1.0.0.{error};

    record session {
        /// The last sequence the service emitted. A reader starts at 0 and
        /// advances by one per chunk it consumes.
        seq: u64,
        id: string,
        shell: string,
        owner: string,
    }

    record output {
        seq: u64,
        data: list<u8>,
    }

    open: func(shell: string, cols: u32, rows: u32) -> result<session, error>;
    %list: func() -> result<list<session>, error>;
    read: func(id: string, seq: u64, wait-ms: u32) -> result<option<output>, error>;
    /// Writing the `exit` line ends the session; queued output stays readable.
    write: func(id: string, data: list<u8>) -> result<_, error>;
    resize: func(id: string, cols: u32, rows: u32) -> result<_, error>;
    signal: func(id: string, signal: string) -> result<_, error>;
    close: func(id: string) -> result<_, error>;
}

/// A live follower of one session, independent of `terminal.read` (§20). The
/// package stays at 1.0.0 so the existing `terminal` export is unchanged.
interface subscription {
    use anth:error/kinds@1.0.0.{error};

    /// Starts at `seq`; ends cleanly when the shell ends. A cursor older than
    /// the retained buffer fails with `exhausted`.
    follow: func(id: string, seq: u64) -> result<stream<list<u8>>, error>;
}

world app {
    export terminal;
    export subscription;
}
