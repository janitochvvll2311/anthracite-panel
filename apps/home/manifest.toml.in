manifest_version = 3

[app]
id = "org.anthracite.home"
namespace = "anthracite:home"
name = "Home"
version = "0.1.0"
summary = "Host overview: system, CPU, memory, disks and network."
license = "Apache-2.0"
icon = "web/icon.svg"
icon-sha256 = "{{icon_sha256}}"

[service]
path = "{{service_path}}"
sha256 = "{{sha256}}"
class = "{{service_class}}"
argv = {{service_argv}}

[[export]]
interface = "anthracite:home/host@1.0.0"

[[route]]
method = "GET"
path = "/info"
call = "anthracite:home/host@1.0.0#info"

[[route]]
method = "GET"
path = "/watch"
call = "anthracite:home/host@1.0.0#watch"
stream = true
events = true

[[cli]]
call = "anthracite:home/host@1.0.0#info"
verb = "info"

[[slot]]
id = "panel.view"
label = "Home"
icon = "home"
order = 1
tag = "home"
module = "web/home.js"
sha256 = "{{module_sha256}}"

[[slot]]
id = "panel.fab"
label = "Refresh"
icon = "web/refresh.svg"
icon-sha256 = "{{refresh_sha256}}"
order = 30
tag = "refresh"
view = "home"
module = ""
sha256 = ""

[[slot.actions]]
label = "Refresh"
icon = "web/refresh.svg"
icon-sha256 = "{{refresh_sha256}}"
tag = "refresh"
action = "refresh"
