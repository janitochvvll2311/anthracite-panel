package anth:host@1.0.0;

/// The host catalog an app's WIT is resolved against (§7.3). This world is not
/// composed: it exists so the package resolves as one unit, with every native
/// interface in `deps/` available to an app's `use` and `import`.
world host {
    import anth:env/info@1.0.0;
    import anth:env/time@1.0.0;
    import anth:env/log@1.0.0;
    import anth:env/random@1.0.0;
    import anth:store/kv@1.0.0;
}
